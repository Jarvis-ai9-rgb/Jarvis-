<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JARVIS AI</title>
<style>
body{background:#000;color:#00e5ff;font-family:Arial;text-align:center;padding:20px}
h1{font-size:40px;text-shadow:0 0 20px #00e5ff}
button{padding:15px 30px;font-size:20px;background:#00e5ff;border:none;border-radius:30px;margin-top:20px}
#chat{background:#111;padding:15px;border-radius:15px;margin-top:20px;min-height:200px;text-align:left}
</style>
</head>
<body>
<h1>JARVIS</h1>
<p>Your Personal AI Assistant</p>
<button onclick="speak()">Talk to JARVIS</button>
<div id="chat">Hello Sir, I am JARVIS...</div>

<script>
function speak(){
 let msg = new SpeechSynthesisUtterance("Hello Sir, I am Jarvis, online");
 speechSynthesis.speak(msg);
 document.getElementById("chat").innerHTML += "<br><br>You: Hello<br>JARVIS: Yes Sir, I am ready.";
}
</script>
</body>
</html>
